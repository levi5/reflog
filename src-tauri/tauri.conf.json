{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reflog",
  "version": "0.1.0",
  "identifier": "com.reflog.app",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Reflog — cliente Git",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self' data: blob:; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ws:; font-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Reflog - cliente Git",
    "longDescription": "Reflog - cliente Git com resolvedor de conflitos",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "cli": {
      "description": "Reflog - cliente Git com resolvedor de conflitos",
      "args": [
        {
          "name": "path",
          "index": 1,
          "takesValue": true,
          "description": "Caminho do repositório Git para abrir"
        }
      ]
    }
  }
}
